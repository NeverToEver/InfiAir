# Godot 生成物（导入缓存；translations.csv 经 import 生成的产物不入库）
.godot/
*.translation
mono_crash.*.json
*.tmp

# .NET / C#（还原与编译产物不入库）
**/bin/
**/obj/
*.user
.vs/
NuGet.config

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# 导出产物（builds/ 留 .gdignore 哨兵：产物目录不参与编辑器文件系统扫描）
builds/*
!builds/.gdignore

# 本地工具与虚拟环境（根 tools/ 装 Roslynator CLI；必须锚定根目录，
# 裸 tools/ 会连 scripts/tools/ 的已跟踪脚本一并误伤）
/tools/
.venv/
__pycache__/

# 本地数据备份（balance_editor.py 保存时自动写）
data/balance.json.bak

# AI 会话工具产物
.zcode/
.playwright-mcp/
kimi-export-session_*.md
