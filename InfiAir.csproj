<Project Sdk="Godot.NET.Sdk/4.6.2">
  <!-- Godot 主工程（C# 绑定层）：场景/节点脚本与引擎互操作代码。
       csharp/core/（InfiAir.Core 纯 .NET 类库）与 csharp/tests/（core 层单测）由各自 csproj
       管理并显式排除避免双编译（测试工程引用 xunit，主工程不可见）；
       导出时经 ProjectReference 自动携带 InfiAir.Core.dll。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>InfiAir</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="csharp/core/**" />
    <Compile Remove="csharp/tests/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="csharp/core/InfiAir.Core.csproj" />
  </ItemGroup>
</Project>
